{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/genephylo//nextflow_schema.json",
    "title": "nf-core/genephylo pipeline parameters",
    "description": "This pipeline retrieves orthologous gene sequences and construct codon-aware analyses and phylogenetic trees",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["input", "outdir"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with 3 columns, and a header row.",
                    "fa_icon": "fas fa-file-csv",
                    "default": "/flash/YamamotoU/Lea/hackathon/test-data/samplesheet-test.csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open",
                    "default": "/flash/YamamotoU/Lea/hackathon/test-data/"
                }
            }
        },
        "blast_database_options": {
            "title": "Blast database options",
            "type": "object",
            "description": "Define all parameters relative to the database option",
            "default": "",
            "properties": {
                "blastdb_option": {
                    "type": "string",
                    "default": "build",
                    "enum": ["current", "update", "build"],
                    "description": "Configure database option to either download a pre-formatted one (update), build a custom one (build) or reference a local database (current)."
                },
                "blastdb_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to a local database (required for current option)."
                },
                "blastdb_update": {
                    "type": "string",
                    "default": "core_nt",
                    "description": "Name of a ncbi pre-formatted nucleotide database (required for update option)."
                },
                "blastdb_build": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to the fasta file of the sequences for the custom database (required for build option).",
                    "default": "/flash/YamamotoU/Lea/hackathon/test-data/testdb.fa"
                },
                "blastdb_buildmap": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to a file associating each sequence id of the custom database to its taxid (required for build option).",
                    "default": "/flash/YamamotoU/Lea/hackathon/test-data/taxid.map"
                },
                "taxdump": {
                    "type": "string",
                    "description": "taxdump.tar.gz file containing nodes.dmp, names.dmp which assign taxonomy to NCBI taxIDs"
                }
            },
            "required": ["blastdb_option"],
            "fa_icon": "fas fa-database"
        },
        "blast_options": {
            "title": "Blast options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "blast_type": {
                    "type": "string",
                    "default": "nt",
                    "enum": ["aa", "nt"],
                    "description": "choose either nucleotide or protein database"
                },
                "blast_coverage": {
                    "type": "integer",
                    "default": 50,
                    "description": "% of query vs hit identity"
                },
                "blast_identity": {
                    "type": "integer",
                    "default": 50,
                    "description": "proportion  of exact matches"
                },
                "blast_evalue": {
                    "type": "number",
                    "default": 0.1,
                    "description": "number of hits with similiar or better score to by found by chance when searching the database of similiar size"
                },
                "blast_hits": {
                    "type": "integer",
                    "default": 100,
                    "description": "positive matches to query sequence"
                },
                "blast_taxids": {
                    "type": "string",
                    "description": "numbers assigned by NCBI to identify taxonomical units"
                }
            },
            "required": ["blast_type", "blast_coverage", "blast_identity", "blast_evalue", "blast_hits"],
            "fa_icon": "fas fa-align-left"
        },
        "phylogeny_options": {
            "title": "Phylogeny options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "tree_tool": {
                    "type": "string",
                    "default": "fasttree",
                    "description": "Choose which software to use to infer phylogenetic tree.",
                    "enum": ["iqtree", "fasttree"]
                }
            },
            "required": ["tree_tool"],
            "fa_icon": "fas fa-tree"
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full detailed help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message (only works when --help or --help_full are provided)."
                }
            }
        },
        "new_group_1": {
            "title": "Configs and emails",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "email": {
                    "type": "string",
                    "hidden": true,
                    "description": "NA"
                },
                "email_on_fail": {
                    "type": "string",
                    "hidden": true,
                    "description": "NA"
                },
                "plaintext_email": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "NA"
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "hidden": true,
                    "description": "NA"
                },
                "hook_url": {
                    "type": "string",
                    "hidden": true,
                    "description": "NA"
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/",
                    "hidden": true,
                    "description": "NA"
                },
                "config_profile_description": {
                    "type": "string",
                    "hidden": true,
                    "description": "NA"
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "NA"
                },
                "custom_config_version": {
                    "type": "string",
                    "default": "master",
                    "description": "NA"
                },
                "custom_config_base": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "description": "NA"
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "NA",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "NA",
                    "hidden": true
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "NA",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/blast_database_options"
        },
        {
            "$ref": "#/$defs/blast_options"
        },
        {
            "$ref": "#/$defs/phylogeny_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        },
        {
            "$ref": "#/$defs/new_group_1"
        }
    ]
}
