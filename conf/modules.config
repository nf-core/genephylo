/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'BLAST_UPDATEBLASTDB' {
        ext.args = "--decompress"
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLAST_MAKEBLASTDB' {
        ext.args = [
          "-dbtype nucl",
          "-parse_seqids"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLAST_BLASTN' {
    ext.args = [
          "-evalue ${params.blast_evalue}",
          "-perc_identity ${params.blast_identity}",
          "-max_target_seqs ${params.blast_hits}",
          "-qcov_hsp_perc ${params.blast_coverage}",
          "-outfmt '6 sseqid staxids'"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLAST_TBLASTN' {
    ext.args = [
          "-evalue ${params.blast_evalue}",
          "-max_target_seqs ${params.blast_hits}",
          "-qcov_hsp_perc ${params.blast_coverage}",
          "-outfmt '6 sseqid staxids'"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_BLASTEXTRACT' {
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_RMDUP' {
        ext.prefix = { "${meta.id}_uniq" }
        publishDir = [
            path: { "${params.outdir}/initial" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ETE_TAXDB' {
        publishDir = [
            path: { "${params.outdir}/blast/BLASTDB" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ETE_FILTER' {
        publishDir = [
            path: { "${params.outdir}/initial" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TD2_LONGORFS' {
        ext.prefix = { "${meta.id}_orfs" }
        publishDir = [
            path   : { "${params.outdir}/initial" },
            mode   : params.publish_dir_mode,
            saveAs : { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_CLEANORFS' {
        publishDir = [
            path   : { "${params.outdir}/initial" },
            mode   : params.publish_dir_mode,
            saveAs : { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAFFT_INITIAL' {
        ext.args = "--quiet"
        ext.prefix = { "${meta.id}_mafft" }
        publishDir = [
            path: { "${params.outdir}/initial" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTTREE' {
        // ext.args = "-quote"
        ext.prefix = { "${meta.id}_fasttree" }
        publishDir = [
            path: { "${params.outdir}/initial" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TREERECS' {
        publishDir = [
            path: { "${params.outdir}/orthogroups" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_ORTHOGROUP' {
        publishDir = [
            path: { "${params.outdir}/orthogroups" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_GREP' {
        ext.prefix = { "${meta.id}_orthogroup" }
        publishDir = [
            path: { "${params.outdir}/orthogroups" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAFFT_FINAL' {
        ext.args = "--quiet"
        ext.prefix = { "${meta.id}_mafft" }
        publishDir = [
            path: { "${params.outdir}/final" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACSE_REFINEALIGNMENT' {
        publishDir = [
            path: { "${params.outdir}/final" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IQTREE' {
        label = "process_high"
        publishDir = [
            path: { "${params.outdir}/final" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
