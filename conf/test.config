/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/genephylo -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data (nf-core/test-datasets, branch "genephylo")
    input            = params.pipelines_testdata_base_path + 'genephylo/samplesheet/v1.0/test_samplesheet_nt.csv'

    // Build a small custom nucleotide BLAST database (60 simulated mRNAs, 15 mammals)
    blastdb_option   = 'build'
    blastdb_build    = params.pipelines_testdata_base_path + 'genephylo/testdata/blastdb/mammals_db.fasta'
    blastdb_buildmap = params.pipelines_testdata_base_path + 'genephylo/testdata/blastdb/mammals_taxid_map.txt'

    // BLAST: nucleotide queries (blastn). At 80% identity, the expected hits are
    // TSTG1 + TSTG2 in 13 species, no TSTG3, no decoys (see test-datasets README)
    blast_type       = 'nt'
    blast_identity   = 80

    // TREERECS
    species_tree     = params.pipelines_testdata_base_path + 'genephylo/testdata/speciestree/mammals_sptree_codes.nwk'
}
